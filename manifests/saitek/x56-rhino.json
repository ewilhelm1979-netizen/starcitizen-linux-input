{
  "$schema": "device-manifest.schema.json",
  "schemaVersion": 1,
  "id": "saitek-x56-rhino",
  "displayName": "Saitek X-56 Rhino HOTAS",
  "description": "Validated two-component X-56 stick and throttle manifest; native Linux, Wine, and Star Citizen operation are tested in the documented maintainer reference environment, while scoped HIDRAW uaccess remains a separately tracked candidate.",
  "devices": [
    {
      "role": "stick",
      "vendorId": "0738",
      "productId": "2221",
      "transport": "usb",
      "expectedNodes": ["hidraw", "event", "joystick"]
    },
    {
      "role": "throttle",
      "vendorId": "0738",
      "productId": "a221",
      "transport": "usb",
      "expectedNodes": ["hidraw", "event", "joystick"]
    }
  ],
  "accessPolicy": {
    "hidraw": "uaccess",
    "input": "verify-only"
  },
  "support": {
    "nativeLinux": "tested",
    "hidrawUaccess": "candidate",
    "wine": "tested",
    "starCitizen": "tested"
  },
  "references": [
    {
      "type": "issue",
      "url": "https://github.com/LovingMelody/nix-citizen/issues/108"
    },
    {
      "type": "documentation",
      "url": "https://github.com/ewilhelm1979-netizen/starcitizen-linux-input/blob/main/docs/research/x56-functional-validation.md"
    }
  ]
}
