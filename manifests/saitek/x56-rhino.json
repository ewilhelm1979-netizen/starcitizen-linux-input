{
  "$schema": "device-manifest.schema.json",
  "schemaVersion": 1,
  "id": "saitek-x56-rhino",
  "displayName": "Saitek X-56 Rhino HOTAS",
  "description": "Research manifest for the separate X-56 stick and throttle; scoped HIDRAW access is a candidate test, not a confirmed fix.",
  "devices": [
    {
      "role": "stick",
      "vendorId": "0738",
      "productId": "2221",
      "transport": "usb",
      "expectedNodes": ["hidraw", "event", "joystick"]
    },
    {
      "role": "throttle",
      "vendorId": "0738",
      "productId": "a221",
      "transport": "usb",
      "expectedNodes": ["hidraw", "event", "joystick"]
    }
  ],
  "accessPolicy": {
    "hidraw": "uaccess",
    "input": "verify-only"
  },
  "support": {
    "nativeLinux": "reported",
    "hidrawUaccess": "candidate",
    "wine": "reported",
    "starCitizen": "unverified"
  },
  "references": [
    {
      "type": "issue",
      "url": "https://github.com/LovingMelody/nix-citizen/issues/108"
    }
  ]
}
